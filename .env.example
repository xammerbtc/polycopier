# polycopier secrets — DO NOT version control
# Only signing credentials belong here.
# Target wallets and all tunables go in config.toml.

PRIVATE_KEY="your-64-hex-char-private-key-here"
FUNDER_ADDRESS="0xYourFunderAddressHere"
# Authenticated dashboard (username polycopier). Use a unique random token, >=24 chars.
# Simulation can run with no PRIVATE_KEY or FUNDER_ADDRESS configured.
DASHBOARD_TOKEN=replace-with-a-random-token-of-at-least-24-characters
DASHBOARD_BIND=127.0.0.1:3000

# Select the actual wallet type: 0=eoa, 1=proxy, 2=Gnosis Safe.
# CLOB_SIGNATURE_TYPE=2
# Live redemption is opt-in and additionally requires POLYCOPIER_MODE=live.
LIVE_REDEEM_ENABLED=false
REDEEM_NODE=/opt/polycopier/runtime/node24
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
