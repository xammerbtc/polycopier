[Unit]
Description=Polycopier isolated live trading service
After=network-online.target polycopier-preview.service
Wants=network-online.target polycopier-preview.service

[Service]
Type=simple
User=polycopier
Group=polycopier
WorkingDirectory=/opt/polycopier-live
EnvironmentFile=/opt/polycopier-live/.env
Environment=POLYCOPIER_MODE=live
Environment=RISK_STATE_PATH=/opt/polycopier-live/runtime-risk.json
Environment=DASHBOARD_BIND=127.0.0.1:3001
Environment=RUST_LOG=polycopier=info,warn
ExecCondition=/usr/bin/python3 /opt/polycopier/deploy/verify-live-stage.py --prestart
ExecStart=/opt/polycopier-live/polycopier --ui-reboot
Restart=on-failure
RestartSec=8
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polycopier-live
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RemoveIPC=true
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polycopier-live

[Install]
WantedBy=multi-user.target
